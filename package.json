{
  "name": "blockcraft",
  "version": "1.0.0",
  "description": "BLOCKCRAFT - a pixel-accurate Minecraft clone in the browser (TypeScript + Three.js + Blender asset pipeline). No emojis. All pixel.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets:textures": "python3 tools/textures/gen_textures.py",
    "assets:models": "bash tools/blender/setup_blender.sh && LD_LIBRARY_PATH=tools/blender/.stubs tools/blender/.venv/bin/python tools/blender/build_models.py"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
